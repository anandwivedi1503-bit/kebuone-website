# Copy to .env.local locally AND on the EC2 server (~/kebuone-website/.env.local).
# Never commit real keys. Restart PM2 / the app after changing these.
# Booking, OTP, Razorpay verify, wallet, RTO and dashboards already work
# without the optional rows. Optional rows only add SMS, webhooks, cron, maps, AI.

NEXT_PUBLIC_SITE_URL=https://www.evuddy.com

# --- Required for the site to boot ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/kebuone

# Firebase web (rider login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (verify rider tokens on APIs)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Ops login
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=change-me-to-at-least-32-characters-long
# ADMIN_SESSION_MAX_AGE=28800

# KYC uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live keys from Razorpay Dashboard → API Keys (Live mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_MODE=live

# Strongly recommended (does not replace in-app verify-payment).
# Razorpay Dashboard → Webhooks
# URL: https://www.evuddy.com/api/razorpay/webhook
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Optional: GitHub Action + this header x-cron-secret on POST /api/jobs/release-unpaid
# CRON_SECRET=

# Optional: IoT device pings (POST /api/iot)
# IOT_DEVICE_SECRET=

# Optional maps on ops IoT view
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional EVUDDY assistant (FAQ always works without these).
# Put ONE of for smarter answers:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Whisper (Hindi/other-language mic) needs OPENAI_API_KEY or GROQ_API_KEY.
# Browser speech is only a backup. The site must allow microphone=(self).

# Optional booking alerts after pay (never blocks Razorpay / OTP).
# Email (Resend):
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=EVUDDY <noreply@your-verified-domain>

# SMS — pickup / ride-end OTP still shows on Book EV without these.
# Add ONE provider on EC2 .env.local, then restart PM2, to also SMS the same OTP.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=EVUDDY
# MSG91_TEMPLATE_ID=
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# WhatsApp via Twilio:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
